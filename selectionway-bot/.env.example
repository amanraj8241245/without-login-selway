# ─────────────────────────────────────────────────────────────
#  Selection Way Bot — Environment Variables
#  इस file को copy करके .env नाम दें और values भरें
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Telegram API credentials — https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Bot Token — @BotFather से लें
BOT_TOKEN=123456789:ABCDEFGHIJKLMNabcdefghijklmn

# Selection Way API base URL (change nahi karna)
BASE_URL=https://raj-selectionwayapi.onrender.com

# Session file directory (/tmp works on all cloud platforms)
SESSION_DIR=/tmp

# Health-check server port (Render automatically sets PORT; local ke liye 8080)
PORT=8080
